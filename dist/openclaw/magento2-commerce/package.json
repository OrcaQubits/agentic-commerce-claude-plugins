{
  "name": "@orcaqubits/openclaw-magento2-commerce",
  "version": "1.0.0",
  "description": "Expert subagent and skills for Magento 2 Open Source development — module creation, DI, plugins, EAV, APIs, checkout, catalog, admin UI, testing, deployment, and PHP 8.x patterns.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "clawhub-plugin",
    "magento",
    "magento2",
    "adobe-commerce",
    "ecommerce",
    "php",
    "module-development",
    "eav",
    "graphql",
    "rest-api",
    "checkout"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OrcaQubits/agentic-commerce-claude-plugins"
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    },
    "hostTargets": [
      "openclaw"
    ],
    "manifest": "./openclaw.plugin.json"
  },
  "author": {
    "name": "Rohit Bajaj, Julekha Khatun",
    "url": "https://orcaqubits-ai.com"
  }
}
