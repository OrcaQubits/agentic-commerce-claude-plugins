{
  "name": "@orcaqubits/openclaw-woocommerce-commerce",
  "version": "1.0.0",
  "description": "Expert subagent and skills for WooCommerce development — plugin/extension creation, hooks/filters, REST API, checkout blocks, payment gateways, shipping methods, HPOS, catalog, admin UI, testing, deployment, and PHP 8.x patterns.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "clawhub-plugin",
    "woocommerce",
    "wordpress",
    "ecommerce",
    "php",
    "plugin-development",
    "rest-api",
    "gutenberg",
    "blocks",
    "checkout",
    "payment-gateways"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OrcaQubits/agentic-commerce-claude-plugins"
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    },
    "hostTargets": [
      "openclaw"
    ],
    "manifest": "./openclaw.plugin.json"
  },
  "author": {
    "name": "Rohit Bajaj, Julekha Khatun",
    "url": "https://orcaqubits-ai.com"
  }
}
